{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Botanic Burn sports drink product item",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "flavor": { "type": "string", "maxLength": 60 },
        "category": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "volume": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "ingredients": { "type": "string", "maxLength": 500 },
        "tag": { "type": "string", "maxLength": 40 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "inStock": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "flavor", "category", "price", "description", "imageUrl", "inStock"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Customer contact or wholesale inquiry message",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator authorized for product catalog updates",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of sports drink products available in the catalog"
    },
    "/contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Customer feedback and business inquiries"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Store verified admin accounts"
    }
  }
}
